{
  "name": "maluti-fruit-loan-app",
  "version": "1.0.0",
  "description": "Maluti Fruit Loan App desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis portable"
  },
  "author": "Maluti Fruit",
  "build": {
    "appId": "com.malutifruit.loanapp",
    "productName": "Maluti Fruit Loan App",
    "files": [
      "main.js",
      "preload.js",
      "pages/**/*",
      "js/**/*",
      "css/**/*",
      "templates/**/*",
      "vendor/**/*"
    ],
    "directories": {
      "output": "C:/Projekte/Maluti Fruit Loan App"
    },
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maluti Fruit Loan App"
    },
    "portable": {
      "artifactName": "Maluti-Fruit-Loan-App-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.4",
    "electron-builder": "^24.13.3"
  }
}
